[Unit]
Description=ServerHive real-time giveaway watcher
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=300
StartLimitBurst=6

[Service]
Type=simple
WorkingDirectory=%h/Dev/serverhive-watch
EnvironmentFile=%h/.config/serverhive-watch.env
Environment=PYTHONUNBUFFERED=1
ExecStart=%h/Dev/serverhive-watch/.venv/bin/python %h/Dev/serverhive-watch/live_watch.py
Restart=always
RestartSec=10
TimeoutStopSec=20

[Install]
WantedBy=default.target
