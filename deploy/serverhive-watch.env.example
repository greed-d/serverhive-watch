# Copy to ~/.config/serverhive-watch.env and chmod 600.
# The Telegram session string is equivalent to a logged-in account.
NTFY_TOPIC=your-secret-topic
NTFY_SERVER=https://ntfy.sh

TG_API_ID=123456
TG_API_HASH=your_api_hash
TG_SESSION_STRING=your_string_session

# Real-time watcher (live_watch.py). The 5-minute Actions backup ignores these.
SITE_POLL_SECONDS=5
LIVE_AUTO_JOIN=1
LIVE_MAX_AGE_SECONDS=600

# Single-shot watcher (watcher.py) state, used by the Actions backup.
STATE_FILE=/home/youruser/.local/state/serverhive-watch/state.json
